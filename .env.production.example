# Copy to `.env` on the VPS (never commit the real file — it holds a secret).
# `docker compose` reads `.env` automatically from the working directory.
#
#   cp .env.production.example .env
#   openssl rand -hex 32   # paste the output in for API_KEY below

# Required. Shared secret between the web and api containers. Generate with
# `openssl rand -hex 32` — don't reuse the auto-generated dev key.
API_KEY=

# Required. The exact origin browsers will see — i.e. your Tailscale Serve
# HTTPS URL (MagicDNS name), e.g. https://bossterminal.your-tailnet.ts.net
# Find your tailnet's domain with `tailscale status` or the admin console.
WEB_ORIGIN=

# Optional. Only set this if you want the AI assistant widget.
ANTHROPIC_API_KEY=

# Optional. Only set to 1 if Tailscale Serve (or another proxy you control)
# is the sole path to the web service and you've confirmed it sets
# X-Forwarded-For from the real client — see docs/deployment/tailscale-vps.md
# "Should I set TRUST_PROXY?" before enabling this.
TRUST_PROXY=

# Optional. How many days of SQLite backups the backup service keeps.
BACKUP_RETENTION_DAYS=14
